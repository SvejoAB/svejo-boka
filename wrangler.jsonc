{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svejo-boka",
  // Account: set CLOUDFLARE_ACCOUNT_ID (for example in .env) before deploying.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "routes": [{ "pattern": "boka.svejo.se", "custom_domain": true }],
  "vars": {
    "PUBLIC_URL": "https://boka.svejo.se",
    "EMAIL_FROM": "noreply@svejo.se"
  },
  // Reminder emails: every five minutes, send the ones that are due.
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "svejo-boka",
      "database_id": "dd02c409-e1bf-4836-b94a-a19eb781ad80",
      "migrations_dir": "migrations"
    }
  ]
}
